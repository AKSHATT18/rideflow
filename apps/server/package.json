{
    "private": true,
    "name": "rideflow-server",
    "version": "1.0.0",
    "main": "dist/server.js",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\"",
        "build": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "start": "node dist/server.js"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "morgan": "^1.12.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.4.0",
        "eslint": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^7.0.2"
    }
}
