# RideFlow Environment Variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rideflow?schema=public"

# Backend
PORT=4000
CLIENT_URL="http://localhost:5173"

# Authentication
JWT_SECRET="your_jwt_secret_here_change_in_production"

# External Services
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
REDIS_URL="redis://localhost:6379"
